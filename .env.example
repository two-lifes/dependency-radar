# Postgres (Neon) connection string. Locally: a Neon dev branch in .env.local;
# in production: the pooled URL (host with -pooler). Keep ?sslmode=require
DATABASE_URL=
# Server-side GitHub token: raises the API limit from 60 to 5000 req/h
GITHUB_TOKEN=
# Set to 1 to mock external APIs with MSW (e2e)
MOCK_EXTERNAL=
